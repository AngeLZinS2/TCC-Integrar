# ── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True

# ── Hosts ─────────────────────────────────────────────────────────────────────
# Comma-separated list (sem espaços)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Formato: postgres://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgres://onboarding_user:onboarding_pass@localhost:5432/onboarding_db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Origins do Flutter Web (dev e prod), separados por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# ── Frontend ─────────────────────────────────────────────────────────────────
# Base usada para montar o link de recuperação de senha enviado por e-mail
FRONTEND_URL=http://localhost:8080

# ── E-mail ───────────────────────────────────────────────────────────────────
# Em dev, o backend de console imprime o e-mail no terminal (nada é enviado).
# Em produção, troque por SMTP e preencha as credenciais.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=nao-responda@onboarding.local

# Validade do link de recuperação de senha, em segundos (padrão: 3 horas)
PASSWORD_RESET_TIMEOUT=10800

# ── Rate limiting ────────────────────────────────────────────────────────────
# Formato do DRF: "<número>/<período>" — second, minute, hour ou day
THROTTLE_LOGIN_IP=5/min
THROTTLE_LOGIN_EMAIL=5/min
THROTTLE_PASSWORD_RESET=3/min

# Cifra as credenciais do banco externo das empresas (P4).
# NAO reaproveitar a SECRET_KEY: girar uma nao pode invalidar a outra.
INTEGRATION_ENCRYPTION_KEY=gere-uma-chave-aleatoria-longa-e-exclusiva
